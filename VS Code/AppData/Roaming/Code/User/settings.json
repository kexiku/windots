{
  "chat.agent.enabled": false,
  "chat.disableAIFeatures": true,
  "cSpell.customDictionaries": {
    "Main": {
      "name": "Main",
      "path": "${env:APPDATA}/Code/User/dictionary.txt",
      "description": "Kexi's custom dictionary",
      "addWords": true
    },
  },
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.language": "en, ru, fr",
  "cSpell.showInRuler": false,
  "editor.formatOnSave": false,
  "editor.lightbulb.enabled": "off",
  "editor.mouseWheelScrollSensitivity": 3,
  "editor.mouseWheelZoom": false,
  "editor.occurrencesHighlight": "off",
  "editor.renderFinalNewline": "dimmed",
  "editor.renderWhitespace": "trailing",
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { // italic comments
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.unicodeHighlight.includeComments": false,
  "editor.unicodeHighlight.includeStrings": false,
  "explorer.compactFolders": false,
  "explorer.expandSingleFolderWorkspaces": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "files.exclude": {
    ".directory": true // directory's metadata file for KDE Plasma
  },
  "git.autofetch": false,
  "git.blame.editorDecoration.template": "${subject} (${authorName})",
  "git.blame.statusBarItem.template": "${authorName}",
  "git.openRepositoryInParentFolders": "never",
  "network.meteredConnection": "off",
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "crash",
  "terminal.integrated.mouseWheelZoom": false,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "off",
    "arguments": "off",
    "unknown": "off"
  },
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  "window.title": "${dirty}${rootNameShort}${profileName}${separator}Code",
  "window.titleSeparator": " ⋅ ",
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Dark Modern",
  "workbench.iconTheme": "a-file-icon-vscode",
  "workbench.layoutControl.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none",
  "workbench.tree.enableStickyScroll": false
}
